# Quick cd to project
cdproj() {
  cd $PROJECTS_ROOT_DIR/$1
}


stream() {
   $DOTFILES_PATH/config/hypr/scripts/stream "$@"
}

hyprlog() {
    cat $XDG_RUNTIME_DIR/hypr/$(ls -t $XDG_RUNTIME_DIR/hypr/ | head -n 2 | tail -n 1)/hyprland.log
}

# yazi wrapper
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

reinstall_completion () {
    zinit creinstall $DOTFILES_PATH/config/zsh/completions
    zinit creinstall $DOTFILES_CUSTOM_PATH/completions
}

