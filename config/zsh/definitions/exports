export EDITOR='nvim'
# Set default editor for sudoedit
export VISUAL='nvim'

# Make some commands not show up in history
export HISTORY_IGNORE="(ls|cd|cd -|pwd|exit|date|* --help)"
# set everything in English
export LC_ALL=en_US.UTF-8

# Enhancd zsh plugin
export ENHANCD_FILTER="fzf"
export ENHANCD_DOT_ARG="..."

# Use to cdproj alias
export PROJECTS_ROOT_DIR="${XDG_PROJECTS_DIR:-$HOME/Projects}"

# Rust
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# Extra paths
export PATH=$DOTFILES_PATH/bin:$HOME/.local/bin:$PATH
export PATH=$HOME/go/bin:$PATH

#  Mise Path
eval "$(mise activate zsh --shims)"

# AWS
export AWS_CLI_AUTO_PROMPT=off
export AWS_PROFILE_STATE_ENABLED=false
export SHOW_AWS_PROMPT=false # Disable reprompt inside aws zsh plugin

# LuaRocks sets LUA_PATH to packages installed
eval "$(luarocks path --bin)"
eval "$(zoxide init zsh --cmd j)"

# vim: ft=zsh
