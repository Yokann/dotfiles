{
  "bars": [
    {
      "id": "main",
      "position": "top",
      "height": 34,
      "layout": {
        "default": {
          "left": [
          ],
          "center": [
            "workspaces"
          ],
          "right": [
            "clock_time"
          ]
        },
        "DP-1": {
          "left": [
            "sysmonitor"
          ],
          "center": [
            "workspaces"
          ],
          "right": [
            "updates",
            "tray",
            "audio",
            "clock_date",
            "clock_time"
          ]
        }
      }
    }
  ],
  "widgets": {
    "clock_time": {
      "type": "clock",
      "format": "HH:mm",
      "showCalendar": false,
      "style": {
        "hoverBackground": "accent"
      }
    },
    "clock_date": {
      "type": "clock",
      "format": "dddd d MMMM"
    }
  }
}
