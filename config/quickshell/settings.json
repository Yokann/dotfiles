{
  "bars": [
    {
      "id": "main",
      "position": "top",
      "height": 34,
      "layout": {
        "default": {
          "left": ["clock_date", "clock_time"]
        }
      }
    }
  ],
  "widgets": {
    "clock_time": {
      "type": "clock",
      "format": "HH:mm",
      "style": { "hoverBackground": "accent" }
    },
    "clock_date": {
      "type": "clock",
      "format": "dddd d MMMM",
      "showCalendar": false
    }
  }
}
