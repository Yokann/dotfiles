{
  "$schema": "https://vicinae.com/schemas/config.json",
  "pop_to_root_on_close": true,
  "font": {
    "normal": {
      "family": "Source Code Pro Medium",
      "size": 12
    }
  },
  "theme": {
    "dark": {
      "name": "catppuccin-macchiato",
      "icon_theme": "Papirus-Adapta-Maia"
    }
  },
  "telemetry": {
    "system_info": false
  },
  "launcher_window": {
    "opacity": 20,
    "client_side_decorations": {
      "enabled": true
    }
  },
  "keybinds": {
    "toggle-action-panel": "control+F"
  },
  "providers": {
    "applications": {
      "preferences": {
        "defaultAction": "focus",
        "launchPrefix": "uwsm app --"
      },
      "entrypoints": {
        "bauh_tray": {
          "enabled": false
        },
        "bssh": {
          "enabled": false
        },
        "bvnc": {
          "enabled": false
        },
        "designer": {
          "enabled": false
        },
        "foot": {
          "enabled": false
        },
        "foot-server": {
          "enabled": false
        },
        "jconsole-java-openjdk": {
          "enabled": false
        },
        "jshell-java-openjdk": {
          "enabled": false
        },
        "linguist": {
          "enabled": false
        },
        "manjaro-documentation": {
          "enabled": false
        },
        "qv4l2": {
          "enabled": false
        },
        "qvidcap": {
          "enabled": false
        },
        "stoken-gui": {
          "enabled": false
        },
        "stoken-gui-small": {
          "enabled": false
        },
        "taskwarrior-tui": {
          "enabled": false
        },
        "vicinae": {
          "enabled": false
        },
        "vim": {
          "enabled": false
        },
        "yad-settings": {
          "enabled": false
        }
      }
    },
    "browser-extension": {
      "enabled": false
    },
    "clipboard": {
      "entrypoints": {
        "history": {
          "alias": ";"
        }
      }
    },
    "core": {
      "entrypoints": {
        "report-bug": {
          "enabled": false
        },
        "search-emojis": {
          "alias": "."
        },
        "sponsor": {
          "enabled": false
        }
      }
    },
    "power": {
      "entrypoints": {
        "hibernate": {
          "enabled": false
        },
        "sleep": {
          "enabled": false
        },
        "soft-reboot": {
          "enabled": false
        }
      }
    },
    "raycast-compat": {
      "enabled": true,
      "entrypoints": {
        "store": {
          "enabled": true
        }
      }
    },
    "system": {
      "entrypoints": {
        "set-default-terminal": {
          "enabled": false
        },
        "volume-0": {
          "enabled": false
        },
        "volume-100": {
          "enabled": false
        },
        "volume-25": {
          "enabled": false
        },
        "volume-50": {
          "enabled": true
        },
        "volume-75": {
          "enabled": false
        },
        "volume-down": {
          "enabled": false
        },
        "volume-up": {
          "enabled": false
        }
      }
    },
    "theme": {
      "enabled": false
    },
    "wm": {
      "enabled": true,
      "entrypoints": {
        "switch-windows": {
          "alias": "$",
          "enabled": true
        },
        "switch-workspaces": {
          "enabled": false
        },
        "toggle-floating": {
          "enabled": false
        },
        "toggle-fullscreen": {
          "enabled": false
        }
      }
    }
  }
}
